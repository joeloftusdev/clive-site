---
import propertyImage from '../assets/property-sold.jpg';

const strategies = [
  {
    tag: 'Higher risk / higher potential return',
    title: 'Forex & Commodity Trading',
    description:
      'Our traders bring significant experience managing large funds across global currency and commodity markets. Every position is placed with discipline, and every trade, win or lose, is reported openly from the day the fund began.',
    points: [
      'Managed by experienced professional traders',
      'Full, trade-by-trade transparency from inception',
      'Live, independently hosted performance reporting',
    ],
    image: 'https://images.unsplash.com/photo-1642790106117-e829e14a795f?auto=format&fit=crop&w=1200&q=80',
    alt: 'Trading desk with multiple screens showing market charts',
    cta: { label: 'View Live Results', href: 'https://www.myfxbook.com/members/BrownArmadillo/brown-armadillo/12140477', external: true },
  },
  {
    tag: 'Lower risk / steadier, more modest return',
    title: 'Property Development',
    description:
      'For investors who want the security of bricks and mortar, our property track starts from an exceptionally low entry level of £10,000. Your money is secured on property with 25 years to run from the date of completion, with an AAA covenant supporting funding for a successful completion.',
    points: [
      '30-day withdrawal: 7.5% per annum, interest paid monthly',
      '1 year commitment: 8.5% per annum, interest paid monthly',
      '3 year commitment: 10% per annum, interest paid monthly',
      '3 year compounding: 12% per annum, paid at the end of the term',
    ],
    image: propertyImage.src,
    alt: 'New homes development under construction with a sold sign in the foreground',
    cta: { label: 'Enquire About This Track', href: '#contact', external: false },
  },
];
---

<section id="strategies" class="relative bg-ink-2 py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-gold">
        Two Paths, One Goal
      </p>
      <h2 class="text-balance font-display text-4xl font-medium leading-tight text-paper sm:text-5xl">
        Choose the strategy that matches your risk tolerance
      </h2>
      <p class="mt-5 text-balance text-lg leading-relaxed text-ash">
        We don't believe in a single answer for every investor. Instead, we offer
        two distinct routes to building wealth, each with a different balance of
        risk and reward.
      </p>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-2">
      {strategies.map((s) => (
        <div class="reveal group overflow-hidden rounded-2xl border border-white/10 bg-panel transition-colors hover:border-gold/40">
          <div class="relative h-56 overflow-hidden">
            <img
              src={s.image}
              alt={s.alt}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-panel via-panel/10 to-transparent"></div>
          </div>
          <div class="p-8">
            <p class="text-xs font-semibold uppercase tracking-wide text-gold">{s.tag}</p>
            <h3 class="mt-3 font-display text-2xl text-paper">{s.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-ash">{s.description}</p>
            <ul class="mt-6 space-y-3">
              {s.points.map((point) => (
                <li class="flex items-start gap-3 text-sm text-ash">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <a
              href={s.cta.href}
              target={s.cta.external ? '_blank' : undefined}
              rel={s.cta.external ? 'noopener noreferrer' : undefined}
              class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-gold transition-colors hover:text-gold-light"
            >
              {s.cta.label}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
