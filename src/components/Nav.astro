---
const links = [
  { href: '#about', label: 'About' },
  { href: '#strategies', label: 'Strategies' },
  { href: '#track-record', label: 'Track Record' },
  { href: '#security', label: 'Security' },
  { href: '#team', label: 'Team' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-white/0 bg-ink/0 transition-all duration-300"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href="#top" class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gold/60 text-sm font-display text-gold">
        F
      </span>
      <span class="font-display text-lg tracking-wide text-paper">
        Fortitude <span class="text-gold">International</span>
      </span>
    </a>

    <ul class="hidden items-center gap-9 lg:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-ash transition-colors hover:text-gold"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="#contact"
      class="hidden rounded-full border border-gold/70 px-5 py-2 text-sm font-medium text-gold transition-colors hover:bg-gold hover:text-ink lg:inline-block"
    >
      Get Started
    </a>

    <button
      id="nav-toggle"
      class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-paper lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-ink px-6 pb-6 lg:hidden">
    <ul class="flex flex-col gap-1 pt-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-link block rounded-lg px-2 py-3 text-base text-ash transition-colors hover:text-gold"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href="#contact"
          class="mobile-link block rounded-full border border-gold/70 px-4 py-3 text-center text-sm font-medium text-gold"
        >
          Get Started
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) {
      nav.classList.add('bg-ink/90', 'backdrop-blur-md', 'border-white/10');
    } else {
      nav.classList.remove('bg-ink/90', 'backdrop-blur-md', 'border-white/10');
    }
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
