---
const year = new Date().getFullYear();
// TODO: replace with the real Companies House number once known.
const COMPANY_NUMBER = '12345678';
---

<footer class="border-t border-white/10 bg-ink py-14">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-sm">
        <a href="#top" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gold/60 text-sm font-display text-gold">
            F
          </span>
          <span class="font-display text-lg text-paper">
            Fortitude <span class="text-gold">Endeavours</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ash-2">
          Building wealth to make you and your family financially free, through
          transparent trading and asset-backed property strategies.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-ash-2">Explore</p>
          <ul class="mt-4 space-y-2.5 text-sm text-ash">
            <li><a href="#about" class="hover:text-gold">About</a></li>
            <li><a href="#strategies" class="hover:text-gold">Strategies</a></li>
            <li><a href="#track-record" class="hover:text-gold">Track Record</a></li>
            <li><a href="#security" class="hover:text-gold">Security</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-ash-2">Company</p>
          <ul class="mt-4 space-y-2.5 text-sm text-ash">
            <li><a href="#team" class="hover:text-gold">Our Traders</a></li>
            <li><a href="#contact" class="hover:text-gold">Contact</a></li>
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <p class="text-xs font-semibold uppercase tracking-wide text-ash-2">Contact</p>
          <ul class="mt-4 space-y-2.5 wrap-break-word text-sm text-ash">
            <li>
              <a href="mailto:contact@fortitudeendeavours.com" class="hover:text-gold">
                contact@fortitudeendeavours.com
              </a>
            </li>
            <li>fortitudeendeavours.com</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8">
      <p class="text-xs leading-relaxed text-ash-2">
        &copy; {year} Fortitude Endeavours Ltd. All rights reserved. Trading forex,
        commodities and derivatives carries a high level of risk and may not be
        suitable for all investors. Property development returns are not
        guaranteed. Past performance, including results published on myfxbook, is
        not indicative of future results. Nothing on this website constitutes
        financial advice.
      </p>
      <p class="mt-3 text-xs leading-relaxed text-ash-2">
        Fortitude Endeavours Ltd. is registered in England and Wales under company
        number {COMPANY_NUMBER}.
      </p>
    </div>
  </div>
</footer>
