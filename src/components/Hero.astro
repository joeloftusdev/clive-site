---
---

<section id="top" class="relative flex min-h-screen items-center overflow-hidden bg-ink">
  <div class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1444653614773-995cb1ef9efa?auto=format&fit=crop&w=2400&q=80"
      alt="City skyline at dusk, representing global financial markets"
      class="h-full w-full object-cover opacity-45"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/80 to-ink"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/40 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-28 pb-20 lg:px-10">
    <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-gold/40 bg-ink/40 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-gold backdrop-blur-sm">
      Est. November 2025 &middot; Fund results published from inception
    </p>

    <h1 class="max-w-4xl text-balance font-display text-4xl font-medium leading-[1.12] text-paper sm:text-6xl lg:text-7xl">
      Building wealth to make you &amp; your family
      <span class="text-gold">financially free.</span>
    </h1>

    <p class="mt-8 max-w-2xl text-balance text-lg leading-relaxed text-ash sm:text-xl">
      A solid strategy with clear goals. We provide the tools: proven trading
      expertise and asset-backed property opportunities. You decide how to use
      them, according to your own risk tolerance.
    </p>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
      <a
        href="https://www.myfxbook.com/members/BrownArmadillo/brown-armadillo/12140477"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-gold px-7 py-3.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.02] hover:bg-gold-light"
      >
        View Live Track Record
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      <a
        href="#strategies"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 px-7 py-3.5 text-sm font-semibold text-paper transition-colors hover:border-gold/60 hover:text-gold"
      >
        Explore the Strategies
      </a>
    </div>

    <div class="mt-16 grid max-w-2xl grid-cols-2 gap-8 border-t border-white/10 pt-8 sm:grid-cols-4">
      <div>
        <p class="font-display text-2xl text-gold">2</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-ash-2">Strategy tracks</p>
      </div>
      <div>
        <p class="font-display text-2xl text-gold">100%</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-ash-2">Investor-controlled funds</p>
      </div>
      <div>
        <p class="font-display text-2xl text-gold">Live</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-ash-2">Trade-by-trade reporting</p>
      </div>
      <div>
        <p class="font-display text-2xl text-gold">Est. 2025</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-ash-2">Fund inception</p>
      </div>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-ash-2 transition-colors hover:text-gold sm:flex"
    aria-label="Scroll to learn more"
  >
    <span class="text-xs uppercase tracking-[0.2em]">Scroll</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </a>
</section>
